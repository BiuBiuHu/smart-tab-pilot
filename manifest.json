{
  "manifest_version": 3,
  "name": "Smart Tab Pilot",
  "version": "1.1.0",
  "description": "精确 URL 去重跳转 + 语义标签分组 + 快速搜索（打开/最近关闭）",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Tab Pilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "打开 Smart Tab Pilot 并聚焦快速搜索"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/extract.js"],
      "run_at": "document_idle"
    }
  ]
}
