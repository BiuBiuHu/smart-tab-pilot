{
  "manifest_version": 3,
  "name": "Smart Tab Pilot",
  "version": "1.3.0",
  "description": "精确 URL 去重跳转 + 按页面正文语义分组（同域不同主题分不同组）；可选快速搜索；Chrome 侧边栏 UI",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "sessions",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Smart Tab Pilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "打开 Smart Tab Pilot 侧边栏"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/extract.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
